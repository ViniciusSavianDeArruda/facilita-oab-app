# Convenções básicas entre editores. Alinhado com frontend/.prettierrc.json —
# o Prettier continua sendo a autoridade sobre formatação de código.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Markdown usa dois espaços no fim da linha como quebra significativa.
trim_trailing_whitespace = false

[*.py]
indent_size = 4

[Makefile]
indent_style = tab
