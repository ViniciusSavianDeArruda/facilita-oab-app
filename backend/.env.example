# "dev" habilita /docs, /redoc e /openapi.json. Qualquer outro valor (ou
# ausência da variável) mantém desabilitado — é o padrão de produção.
ENV=dev

#Chave
GEMINI_API_KEY=cole_sua_chave_aqui

# Modelo
# "gemini-2.5-flash"
GEMINI_MODEL=gemini-flash-latest

# Origens permitidas (front local + front em produção, separadas por vírgula,
# sem barra no final). Em produção, troque/inclua o domínio real do front,
# ex: CORS_ORIGINS=http://localhost:5173,https://seu-dominio-de-producao.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Senha única pra acessar o app (é uso pessoal — não tem cadastro/e-mail).
# Escolha algo forte já que o backend vai ficar exposto na internet.
APP_PASSWORD=troque_isso_por_uma_senha_forte

# Chave secreta pra assinar o token de sessão — gere algo aleatório, ex:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=troque_isso_por_um_segredo_aleatorio
ACCESS_TOKEN_EXPIRE_DAYS=30

# Banco de dados. Postgres é o padrão (local via docker-compose, produção
# via Neon ou similar). SQLite ainda funciona (útil só pra emergência/dev
# avulso sem Docker), mas não é mais o caminho principal do projeto:
#   DATABASE_URL=sqlite:///./facilita.db
DATABASE_URL=postgresql+psycopg2://facilita:dev_local_only@postgres:5432/facilita
