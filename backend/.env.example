#Chave
GEMINI_API_KEY=cole_sua_chave_aqui

# Modelo
# "gemini-2.5-flash"
GEMINI_MODEL=gemini-flash-latest

# Origens permitidas (front local + front em produção, separadas por vírgula)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Senha única pra acessar o app (é uso pessoal — não tem cadastro/e-mail).
# Escolha algo forte já que o backend vai ficar exposto na internet.
APP_PASSWORD=troque_isso_por_uma_senha_forte

# Chave secreta pra assinar o token de sessão — gere algo aleatório, ex:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=troque_isso_por_um_segredo_aleatorio
ACCESS_TOKEN_EXPIRE_DAYS=30

# Banco de dados.
DATABASE_URL=sqlite:///./facilita.db
